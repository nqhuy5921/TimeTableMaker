{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/main",
    "src/preload",
    "src/shared",
    "src/domain",
    "tests",
    "fixtures",
    "scripts",
    "electron.vite.config.ts",
    "vitest.config.mts",
    "playwright.config.ts"
  ]
}
